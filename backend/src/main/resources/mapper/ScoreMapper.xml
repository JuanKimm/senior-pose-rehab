<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<!-- AI 연동 - 운동 점수 데이터 저장 -->
<mapper namespace="com.seniorrehab.repository.ScoreMapper">

    <!-- 세션의 기존 점수 삭제 (재전송 시 중복 저장 방지) -->
    <delete id="deleteScoresBySessionId">
        DELETE FROM EXERCISE_SCORE
        WHERE session_id = #{sessionId}
    </delete>

    <!-- 운동 점수 데이터 일괄 저장 (angle_diff 제외) -->
    <insert id="insertScores">
        INSERT INTO EXERCISE_SCORE (session_id, action_no, action_score)
        VALUES
        <foreach collection="scores" item="score" separator=",">
            (#{sessionId}, #{score.actionNo}, #{score.actionScore})
        </foreach>
    </insert>

</mapper>